# ---------------------------------------------------------------------------
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values.
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit terraform.tfvars — it is already in .gitignore.
# ---------------------------------------------------------------------------

# Your AWS Organizations ID — found in the AWS console under
# AWS Organizations > Settings, or by running:
#   aws organizations describe-organization --query 'Organization.Id' --output text
org_id = "o-xxxxxxxxxx"

# AWS account ID where IBM Turbonomic is deployed.
# Found in the Turbonomic console or by running:
#   aws sts get-caller-identity --query Account --output text
#   (while authenticated as the Turbonomic service account)
turbonomic_account_id = "123456789012"

# AWS region (IAM is global but the provider requires a region).
aws_region = "us-east-1"

# ---------------------------------------------------------------------------
# Optional — defaults shown below, only set if you need to override
# ---------------------------------------------------------------------------

# Name of the IAM role created in the management account.
# management_role_name = "TurbonomicMonitorRole"

# Name of the IAM policy created in the management account.
# policy_name = "TurbonomicMonitorPolicy"

# External ID for the role trust policy.
# Strongly recommended — use a UUID or any hard-to-guess string and give it
# to your Turbonomic administrator to enter when configuring the target.
# Generate one with: uuidgen
# external_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Tags applied to all IAM resources.
# tags = {
#   ManagedBy   = "Terraform"
#   Application = "Turbonomic"
#   Environment = "production"
# }
